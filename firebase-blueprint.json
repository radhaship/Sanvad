  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/PrivateUser" },
      "description": "Owner-only private user account document."
    },
    "/users/{userId}/starred/{starId}": {
      "schema": { "$ref": "#/entities/StarredMessage" },
      "description": "Owner-only starred/bookmarked message references."
    },
    "/users_public/{userId}": {
      "schema": { "$ref": "#/entities/PublicUser" },
      "description": "Public profile and live presence document without PII."
    },
    "/handles/{handleId}": {
      "schema": { "$ref": "#/entities/UserHandle" },
      "description": "Handle-to-UID directory mapping."
    },
    "/statuses/{statusId}": {
      "schema": { "$ref": "#/entities/Status" },
      "description": "24-hour status stories posted by users."
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/Chat" },
      "description": "Direct and group chat rooms."
    },
    "/group_invites/{inviteCode}": {
      "schema": { "$ref": "#/entities/GroupInvite" },
      "description": "Secret invite code mappings for joining groups."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Messages inside a chat room."
    },
    "/chats/{chatId}/typing/{userId}": {
      "schema": { "$ref": "#/entities/TypingStatus" },
      "description": "Real-time typing indicator documents inside a chat room."
    },
    "/chats/{chatId}/polls/{pollId}": {
      "schema": { "$ref": "#/entities/Poll" },
      "description": "Interactive decision polls inside a chat room."
    },
    "/chats/{chatId}/polls/{pollId}/votes/{voterId}": {
      "schema": { "$ref": "#/entities/PollVote" },
      "description": "Individual votes for a poll."
    },
    "/chats/{chatId}/checklist_items/{itemId}": {
      "schema": { "$ref": "#/entities/ChecklistItem" },
      "description": "Shared trip planning and hangout checklist items inside a group chat."
    },
    "/chats/{chatId}/game_results/{resultId}": {
      "schema": { "$ref": "#/entities/GameResult" },
      "description": "Mini-game scores and wins inside a chat room for the real-time Game Leaderboard."
    },
    "/confessions/{confessionId}": {
      "schema": { "$ref": "#/entities/ConfessionPost" },
      "description": "Anonymous confessions and secrets board posts without author PII."
    },
    "/confessions_authors/{confessionId}": {
      "schema": { "$ref": "#/entities/ConfessionAuthor" },
      "description": "Owner-only private authorship lookup for anonymous confessions."
    },
    "/calls/{callId}": {
      "schema": { "$ref": "#/entities/Call" },
      "description": "1-on-1 WebRTC call signaling documents."
    },
    "/calls/{callId}/candidates/{candidateId}": {
      "schema": { "$ref": "#/entities/IceCandidate" },
      "description": "ICE candidates exchanged during WebRTC call setup."
    },
    "/app_stats/{statsId}": {
      "schema": { "$ref": "#/entities/AppStats" },
      "description": "Non-PII aggregate statistics document (/app_stats/summary)."
    }
  }
