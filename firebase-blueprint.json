        },
        "lastMessageType": {
          "type": "string",
          "enum": ["none", "text", "image", "audio", "poll", "meet", "file"]
        },
        "lastMessageSenderId": {
          "type": "string",
          "maxLength": 128
        },
        "lastMessageAt": {
