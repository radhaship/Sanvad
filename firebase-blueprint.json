{
  "entities": {
    "PrivateUser": {
      "title": "PrivateUser",
      "description": "Private user account profile containing PII isolated to the owner.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the account owner."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 120,
          "description": "Verified account email address."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "User display name."
        },
        "handle": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30,
          "pattern": "^[a-z0-9_\\-]+$",
          "description": "Unique friend handle."
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 240000,
          "description": "Profile avatar URL or compressed data URI."
        },
        "bio": {
          "type": "string",
          "maxLength": 160,
          "description": "Short status or about text."
        },
        "discoverable": {
          "type": "boolean",
          "description": "Whether the user appears in the friends directory."
        },
        "pinnedChatIds": {
          "type": "array",
          "description": "Bounded list of user-pinned chat IDs (max 20)."
        },
        "archivedChatIds": {
          "type": "array",
          "description": "Bounded list of user-archived chat IDs (max 50)."
        },
        "wallpaper": {
          "type": "string",
          "maxLength": 40,
          "description": "Default chat wallpaper preset ID."
        },
        "chatWallpapers": {
          "type": "object",
          "description": "Per-chat wallpaper preset overrides keyed by chat ID."
        },
        "readReceiptsEnabled": {
          "type": "boolean",
          "description": "Privacy preference controlling whether read receipts (blue ticks) are sent and shown."
        },
        "accentColor": {
          "type": "string",
          "maxLength": 30,
          "description": "User custom theme accent color preset."
        },
        "fontSize": {
          "type": "string",
          "enum": ["sm", "md", "lg"],
          "description": "User message text font size preference."
        },
        "mutedChatIds": {
          "type": "array",
          "description": "Bounded list of muted chat IDs (max 100)."
        },
        "blockedUids": {
          "type": "array",
          "description": "Bounded list of blocked user UIDs (max 100)."
        },
        "deletedChats": {
          "type": "object",
          "description": "Map of chat ID to deletion timestamp in ms so old messages stay cleared."
        },
        "fcmTokens": {
          "type": "array",
          "description": "Bounded list of FCM Web Push registration tokens for the user's devices (max 10)."
        },
        "fcmTokenUpdatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of the most recent FCM token registration."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "handle",
        "photoUrl",
        "bio",
        "discoverable",
        "createdAt",
        "updatedAt"
      ]
    },
    "PublicUser": {
      "title": "PublicUser",
