        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "type",
        "name",
        "photoUrl",
        "createdBy",
        "adminUids",
        "memberUids",
        "inviteCode",
        "lastInviteUsed",
        "lastMessageText",
        "lastMessageType",
        "lastMessageSenderId",
        "lastMessageAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "GroupInvite": {
